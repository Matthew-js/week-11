{
  "openapi": "3.0.3",
  "info": {
    "title": "Toko API (via Gateway)",
    "version": "1.0.0",
    "description": "Dokumentasi gabungan product-service dan order-service"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/product-service/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Daftar semua produk",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/product-service/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Detail satu produk",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/product-service/products/{id}/reserve": {
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Cek dan kurangi stok produk (dipanggil order-service)",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stok berhasil dikurangi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReserveResponse"
                }
              }
            }
          },
          "400": {
            "description": "quantity tidak valid, atau body bukan JSON yang valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stok tidak cukup",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "available": {
                          "type": "integer",
                          "example": 5
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/order-service/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Daftar semua pesanan",
        "description": "Tidak menghubungi product-service, jadi tetap 200 walau product-service mati.",
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Buat pesanan baru",
        "description": "Memanggil product-service untuk mengurangi stok (timeout 2 detik), lalu menyimpan pesanan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pesanan dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Input tidak valid, atau body bukan JSON yang valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stok tidak cukup",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "available": {
                          "type": "integer",
                          "example": 5
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Respons tidak terduga dari product-service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "product-service tidak dapat dihubungi (mati, ditolak, atau lebih dari 2 detik)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Kopi Arabika 250g"
          },
          "price": {
            "type": "integer",
            "example": 85000
          },
          "stock": {
            "type": "integer",
            "example": 10
          },
          "category": {
            "type": "string",
            "example": "Periferal"
          }
        }
      },
      "ReserveRequest": {
        "type": "object",
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "ReserveResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Kopi Arabika 250g"
          },
          "price": {
            "type": "integer",
            "example": 85000
          },
          "reserved": {
            "type": "integer",
            "example": 2
          },
          "remainingStock": {
            "type": "integer",
            "example": 8
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Produk tidak ditemukan"
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "productId": {
            "type": "integer",
            "example": 1
          },
          "productName": {
            "type": "string",
            "example": "Kopi Arabika 250g"
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "unitPrice": {
            "type": "integer",
            "example": 85000
          },
          "total": {
            "type": "integer",
            "example": 170000
          },
          "status": {
            "type": "string",
            "example": "confirmed"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
